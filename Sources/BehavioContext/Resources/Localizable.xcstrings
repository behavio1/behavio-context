    "UI Screen Context preserved the partial recording. Show it in Finder to see whether it can be played.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UI Screen Context hat die Teilaufnahme erhalten. Zeige sie im Finder, um zu prüfen, ob sie abgespielt werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI Screen Context preserved the partial recording. Show it in Finder to see whether it can be played."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UI Screen Context conservó la grabación parcial. Muéstrala en el Finder para comprobar si se puede reproducir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowano częściowe nagranie. Otwórz je w Finderze, aby sprawdzić, czy można je odtworzyć."
          }
        }
      }
    },
    "No usable recording was produced. Check your recording settings and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine verwendbare Aufnahme erstellt. Prüfe die Aufnahmeeinstellungen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable recording was produced. Check your recording settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se produjo una grabación utilizable. Comprueba los ajustes de grabación e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie powstało nagranie, które można odtworzyć. Sprawdź ustawienia nagrywania i spróbuj ponownie."
          }
        }
      }
    },
