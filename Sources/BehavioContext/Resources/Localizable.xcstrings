    "Couldn’t return to the original app. Switch to your destination and press ⌘V to paste.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche App konnte nicht aktiviert werden. Wechsle zur gewünschten App und füge den Kontext mit ⌘V ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t return to the original app. Switch to your destination and press ⌘V to paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo volver a la app original. Cambia al destino y pulsa ⌘V para pegar."
