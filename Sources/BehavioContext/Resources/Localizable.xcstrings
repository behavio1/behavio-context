    "No compatible model found. Choose a ggml .bin model. Existing .pt or MLX weights need local conversion; nothing will be downloaded automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible model found. Choose a ggml .bin model. Existing .pt or MLX weights need local conversion; nothing will be downloaded automatically."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zgodnego modelu. Wybierz model ggml .bin. Wagi .pt lub MLX wymagają lokalnej konwersji; nic nie zostanie pobrane automatycznie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un modelo compatible. Elige un modelo ggml .bin. Los pesos .pt o MLX requieren conversión local; no se descargará nada automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein kompatibles Modell gefunden. Wähle ein ggml-.bin-Modell. Vorhandene .pt- oder MLX-Dateien müssen lokal konvertiert werden; es wird nichts automatisch geladen."
          }
        }
      }
    },
