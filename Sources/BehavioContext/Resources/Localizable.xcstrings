    "No screen or window is available. Check Screen Recording permission and refresh sources.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bildschirm oder Fenster verfügbar. Berechtigung für Bildschirmaufnahme prüfen und Quellen aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No screen or window is available. Check Screen Recording permission and refresh sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna pantalla o ventana disponible. Comprueba el permiso de grabación de pantalla y actualiza las fuentes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępnych okien. Sprawdź uprawnienie do nagrywania ekranu i odśwież źródła."
          }
        }
      }
    },
